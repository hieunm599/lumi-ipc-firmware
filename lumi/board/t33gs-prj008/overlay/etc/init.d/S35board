#!/bin/sh
# Peripheral bring-up for the Lumi T33gs PRJ008 board.

[ -f /etc/hardware.env ] && . /etc/hardware.env

case "$1" in
	start)
        if [ "$(/lumi/bin/lumi-config hardware-ptz /lumi/camera-profile.json)" = 1 ]; then
        /lumi/bin/lumi-t33gs-motor-gpio-init ||
            echo "Lumi T33gs: motor GPIO preparation failed" >&2
        fi

		# 1. Power-cycle Wi-Fi module if configured
		if [ -n "$WIFI_PWR_GPIO" ] && [ -e /sys/class/gpio/export ]; then
			[ -d "/sys/class/gpio/gpio${WIFI_PWR_GPIO}" ] || echo "$WIFI_PWR_GPIO" > /sys/class/gpio/export 2>/dev/null || true
			if [ -d "/sys/class/gpio/gpio${WIFI_PWR_GPIO}" ]; then
				echo out > "/sys/class/gpio/gpio${WIFI_PWR_GPIO}/direction"
				echo 1 > "/sys/class/gpio/gpio${WIFI_PWR_GPIO}/value"
				sleep 0.5
				echo 0 > "/sys/class/gpio/gpio${WIFI_PWR_GPIO}/value"
			fi
		fi

		# 2. Load Wi-Fi drivers (if present)
		# Kernel modules are installed under the running kernel release.
		# This BusyBox build does not provide modinfo.
		if [ -d "/lib/modules/$(uname -r)/kernel/drivers/net/wireless/aic8800" ]; then
			modprobe aic_load_fw aic_fw_path=/lib/firmware aicwf_dbg_level=1 2>/dev/null || true
			modprobe aic8800 aicwf_dbg_level=1 2>/dev/null || true
		fi

		# 3. Load TX-ISP module
		MODULE_DIR="/lib/modules/$(uname -r)/ingenic"
		ISP_MOD="${ISP_MODULE:-tx-isp-${SOC_PROJECT:-PRJ008}.ko}"
		if [ -f "$MODULE_DIR/$ISP_MOD" ] && ! lsmod | grep -q '^tx_isp'; then
			insmod "$MODULE_DIR/$ISP_MOD" \
				clk_name=sclka isp_clk=380000000 \
				clka_name=sclka isp_clka=500000000 \
				clkv_name=sclka isp_clkv=380000000 \
				|| echo "Lumi T33: TX-ISP load failed; inspect dmesg" >&2
		fi

		# Source-built TNPU exposes vendor duty counters; preserve current clock/CMA.
		if [ -f "$MODULE_DIR/tnpu.ko" ] && ! lsmod | grep -q '^tnpu'; then
			insmod "$MODULE_DIR/tnpu.ko" parent_clk_name=apll tnpu_clk_rate=500000000 cma_pool_size=${TNPU_CMA_POOL_SIZE:-0} || echo "Lumi TNPU load failed" >&2
		fi

		# 4. Load Sensor module
		SNS_MOD="${SENSOR_MODULE:-sensor_${SENSOR_MODEL:-sc4336}_${SOC_PROJECT:-PRJ008}.ko}"
		if [ -f "$MODULE_DIR/$SNS_MOD" ] && ! lsmod | grep -q '^sensor_'; then
			insmod "$MODULE_DIR/$SNS_MOD" \
				|| echo "Lumi T33: Sensor $SNS_MOD load failed; inspect I2C and dmesg" >&2
		fi

		# 5. Load Audio OSS3 module (if present)
		if [ -f "$MODULE_DIR/audio.ko" ] && ! lsmod | grep -q '^audio'; then
			insmod "$MODULE_DIR/audio.ko" spk_gpio=-1 \
				|| echo 'Lumi T33: OSS3 audio driver failed; inspect dmesg' >&2
		fi
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop}" >&2
		exit 1
		;;
esac
