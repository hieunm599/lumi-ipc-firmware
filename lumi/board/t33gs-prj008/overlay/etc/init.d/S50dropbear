#!/bin/sh

DAEMON="dropbear"
PIDFILE="/var/run/$DAEMON.pid"
KEYFILE=""
DAEMON_ARGS="-B -k -p 22 -K 300"

prepare_hostkey() {
	mtd_index=$(awk -F '[: ]+' '$4 == "\"rootfs_data\"" { sub(/^mtd/, "", $1); print $1; exit }' /proc/mtd)
	if [ -z "$mtd_index" ]; then
		DAEMON_ARGS="$DAEMON_ARGS -R"
		return 0
	fi

	mkdir -p /overlay
	if ! mountpoint -q /overlay; then
		if ! mount -t jffs2 "/dev/mtdblock$mtd_index" /overlay; then
			mountpoint -q /overlay && umount /overlay
			mtd_device="/dev/mtd$mtd_index"
			if grep -q 'nand' /proc/cmdline; then
				flash_eraseall "$mtd_device" || return 1
			else
				flash_eraseall -j "$mtd_device" || return 1
			fi
			mount -t jffs2 "/dev/mtdblock$mtd_index" /overlay || return 1
		fi
	fi

	KEYFILE="/overlay/dropbear/dropbear_rsa_host_key"
	if [ ! -s "$KEYFILE" ]; then
		umask 077
		mkdir -p "${KEYFILE%/*}" || return 1
		dropbearkey -t rsa -s 2048 -f "$KEYFILE" >/dev/null 2>&1 || return 1
		chmod 600 "$KEYFILE" || return 1
	fi
	DAEMON_ARGS="$DAEMON_ARGS -r $KEYFILE"
}

start() {
 [ -f /var/run/lumi-firewall.ready ] || { echo 'SSH refused: firewall not ready' >&2; return 1; }
 if [ -e /overlay/lumi-admin/ssh-key-only ] || [ -L /overlay/lumi-admin/ssh-key-only ]; then
  [ -f /overlay/lumi-admin/ssh-key-only ] && [ ! -L /overlay/lumi-admin/ssh-key-only ] || return 1
  [ "$(stat -c '%u:%a' /overlay/lumi-admin/ssh-key-only)" = 0:600 ] || return 1
  [ "$(cat /overlay/lumi-admin/ssh-key-only)" = key-only-v1 ] || return 1
  [ -s /overlay/dropbear/authorized_keys ] || { echo 'SSH keys missing; refusing password fallback' >&2; return 1; }
  DAEMON_ARGS="$DAEMON_ARGS -s"
 fi
	echo -n "Starting $DAEMON: "
	prepare_hostkey || { echo "FAIL (host key storage unavailable)"; return 1; }
	umask 077
	start-stop-daemon -S -q -p "$PIDFILE" -x "$DAEMON" -- $DAEMON_ARGS
	if [ $? -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
}

stop() {
	echo -n "Stopping $DAEMON: "
	start-stop-daemon -K -q -p "$PIDFILE" -x "$DAEMON"
	if [ $? -eq 0 ]; then
		rm -f "$PIDFILE"
		echo "OK"
	else
		echo "FAIL"
	fi
}

case "$1" in
	start|stop)
		$1
		;;
	restart|reload)
		stop
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
		;;
esac
