#!/bin/sh
# Model configuration owns module startup. IMP starts at most once per boot.
set -eu
umask 077
NAME=lumi-ipc-streamer
BIN=/lumi/bin
PROFILE=/lumi/camera-profile.json
PIDFILE=/var/run/lumi-ipc-streamer.pid
LOCK=/var/run/lumi-ipc-streamer.init-lock
READY=/tmp/lumi-supervisor.ready
STARTED=/tmp/lumi-runtime.started
RELAY_INIT=$BIN/lumi-t33gs-relay-agent

lock() {
 mkdir -p /var/run
 tries=0
 while ! mkdir "$LOCK" 2>/dev/null; do
  owner=$(cat "$LOCK/pid" 2>/dev/null || true)
  if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
   rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || true
  fi
  [ "$tries" -lt 60 ] || return 1
  tries=$((tries + 1)); sleep 1
 done
 echo "$$" > "$LOCK/pid"
 trap 'rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || true' EXIT
}
running() { [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
start() {
 if running; then echo 'Lumi runtime already running'; return 0; fi
 if [ -e "$STARTED" ]; then echo 'Lumi runtime requires reboot before reopening IMP' >&2; return 1; fi
 [ -x "$BIN/ipc-stream-supervisor" ] && [ -x "$BIN/lumi-config" ]
 mountpoint -q /overlay
 tries=0; wlan_ip=''
 while [ "$tries" -lt 30 ]; do
  wlan_ip=$(ip -4 -o addr show dev wlan0 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')
  [ -n "$wlan_ip" ] && break
  tries=$((tries + 1)); sleep 1
 done
 [ -n "$wlan_ip" ] || { echo 'Lumi runtime: Wi-Fi IPv4 unavailable' >&2; return 1; }
 # Also latch failed trials/config preparation: watchdog must not retry a
 # partially mounted candidate or rejected configuration during this boot.
 cat /proc/sys/kernel/random/boot_id > "$STARTED"
 config_root=$($BIN/lumi-config dev-wait "$PROFILE" /overlay /tmp)
 $BIN/lumi-config init "$PROFILE" "$config_root" /tmp
 set -a
 . /tmp/lumi-boot.env
 set +a
 # Owner-selected PRJ008 image profile, qualified by bounded .100 trials.
 # Keep OEM bins/neutral image controls; apply only the selected ISP overrides.
 export T33GS_ISP_TUNING=0 T33GS_ISP_MAX_EXPOSURE_LINES=909
 export T33GS_ISP_TRIAL_SHARPNESS=140 T33GS_ISP_NR_TRIAL=1
 export T33GS_ISP_SINTER_RATIO=112 T33GS_ISP_TEMPER_RATIO=128
 export LUMI_HTTP_ADDR=0.0.0.0:18080
 # Keep listener valid through DHCP changes without reopening the camera owner.
 export LUMI_RTSP_ADDR=0.0.0.0:18554
 # Preserve the separately provisioned voice pilot without embedding secrets.
 voice=/overlay/lumi-voice
 if [ -f "$voice/ENABLED" ] && [ -f "$voice/READY" ]; then
  [ "$(stat -c '%u:%a' "$voice")" = 0:700 ] && [ ! -L "$voice" ]
  [ "$(cat "$voice/ENABLED")" = cpu16k-v1 ]
  mkdir -p /tmp/lumi-voice
  chmod 700 /tmp/lumi-voice
  for name in ENABLED READY model.tflite webrtc_profile.ini luvox.conf; do
   [ -f "$voice/$name" ] && [ ! -L "$voice/$name" ]
   [ "$(stat -c '%u:%a' "$voice/$name")" = 0:600 ]
   cp "$voice/$name" "/tmp/lumi-voice/$name"
   chmod 600 "/tmp/lumi-voice/$name"
  done
  export LUMI_MODULE_VOICE=1 LUMI_VOICE_BIN=$BIN/ipc-voice-worker
  export LUMI_VOICE_DIR=/tmp/lumi-voice LUMI_VOICE_MODEL=/tmp/lumi-voice/model.tflite
  export LUMI_VOICE_CONFIG=/tmp/lumi-voice/luvox.conf
 fi
 unset LUMI_RECORDER_BIN
 export LUMI_MODULE_RECORDING=0
 sd_mount=$(awk '($2 == "/mnt" || $2 ~ /^\/mnt\//) && $1 ~ /^\/dev\/(mmcblk|sd)/ {print $2; exit}' /proc/mounts)
 if [ -n "$sd_mount" ]; then
  if [ -d "$sd_mount/lumi-ipc-streamer/recordings" ]; then
   export LUMI_RECORDING_DIR="$sd_mount/lumi-ipc-streamer/recordings"
  else
   export LUMI_RECORDING_DIR="$sd_mount/lumi/recordings"
  fi
  if [ -e /tmp/lumi-dev-active.json ]; then export LUMI_RECORDING_DIR="$sd_mount/lumi-dev-recordings"; fi
  export LUMI_RECORDER_BIN=$BIN/ipc-stream-recorder
  export LUMI_MODULE_RECORDING=1
 else
  export LUMI_RECORDING_DIR=/mnt/.lumi-no-card
 fi
 if [ "$LUMI_MODULE_PTZ" = 1 ]; then
  [ -c /dev/motor ] || insmod /lib/modules/3.10.14/ingenic/lumi_motor.ko
  chmod 600 /dev/motor
 fi
 rm -f "$READY"
 "$BIN/ipc-stream-supervisor" >> /tmp/lumi-streamer.log 2>&1 &
 pid=$!; echo "$pid" > "$PIDFILE"
 tries=0
 while [ "$tries" -lt 30 ]; do
  if [ -f "$READY" ] && kill -0 "$pid" 2>/dev/null; then
   if [ "$LUMI_MODULE_RELAY" = 1 ]; then
    if [ -s "$LUMI_RELAY_KEY" ]; then "$RELAY_INIT" start >> /tmp/lumi-relay.log 2>&1 || echo 'Lumi relay startup failed' >&2
    else echo 'Lumi relay waiting for device identity'; fi
   fi
   echo 'Lumi runtime ready'; return 0
  fi
  kill -0 "$pid" 2>/dev/null || break
  tries=$((tries + 1)); sleep 1
 done
 echo 'Lumi runtime failed; inspect /tmp/lumi-streamer.log; reboot required' >&2
 return 1
}
stop() {
 "$RELAY_INIT" stop || true
 if running; then
  pid=$(cat "$PIDFILE"); kill -TERM "$pid"
  tries=0
  while kill -0 "$pid" 2>/dev/null && [ "$tries" -lt 10 ]; do sleep 1; tries=$((tries + 1)); done
  kill -0 "$pid" 2>/dev/null && kill -TERM "$pid" 2>/dev/null || true
 fi
 rm -f "$PIDFILE" "$READY"
}
case "${1:-}" in
 start|stop) lock; "$1" ;;
 restart|reload) echo 'Reboot required to apply runtime module changes' >&2; exit 1 ;;
 *) echo "Usage: $0 {start|stop}" >&2; exit 64 ;;
esac
