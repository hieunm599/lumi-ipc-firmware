CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_I2C_CHARDEV=y
# This Wi-Fi board uses PB6-PB11/PB13-PB14 for the ULN motor inputs.
# GMAC_PORTB overlaps them; do not reserve or mux these pins for Ethernet.
# CONFIG_JZ_MAC is not set
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
CONFIG_IPV6=y

# Public-media security profile: established traffic and explicit inbound policy.
CONFIG_SYN_COOKIES=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_CONNTRACK_IPV6=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
