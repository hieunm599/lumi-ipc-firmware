#!/bin/sh
# Experimental PRJ008 media bring-up for the T33gs SK032T4/SC4336 camera.
# Uses only SDK-sourced TX-ISP and the SC4336 source staged for PRJ008.

case "$1" in
	start)
		# The camera uses an AIC8800D80 USB combo module. The original board
		# power-cycles it through GPIO72 before loading the USB drivers.
		if [ -e /sys/class/gpio/export ]; then
			[ -d /sys/class/gpio/gpio72 ] || echo 72 > /sys/class/gpio/export 2>/dev/null || true
			if [ -d /sys/class/gpio/gpio72 ]; then
				echo out > /sys/class/gpio/gpio72/direction
				echo 1 > /sys/class/gpio/gpio72/value
				sleep 0.5
				echo 0 > /sys/class/gpio/gpio72/value
			fi
		fi
		modprobe aic_load_fw aic_fw_path=/lib/firmware aicwf_dbg_level=1 \
			|| echo 'T33gs: AIC firmware loader module failed' >&2
		modprobe aic8800 aicwf_dbg_level=1 \
			|| echo 'T33gs: AIC8800D80 Wi-Fi module failed' >&2
		MODULE_DIR=/lib/modules/3.10.14/ingenic
		if [ ! -f "$MODULE_DIR/tx-isp-PRJ008.ko" ] || [ ! -f "$MODULE_DIR/sensor_sc4336_PRJ008.ko" ]; then
			echo 'T33gs: PRJ008 ISP/sensor modules are missing' >&2
			exit 1
		fi
		if ! lsmod | grep -q '^tx_isp'; then
			insmod "$MODULE_DIR/tx-isp-PRJ008.ko" \
				clk_name=sclka isp_clk=380000000 \
				clka_name=sclka isp_clka=500000000 \
				clkv_name=sclka isp_clkv=380000000 \
				|| { echo 'T33gs: TX-ISP load failed; inspect dmesg' >&2; exit 1; }
		fi
		if ! lsmod | grep -q '^sensor_sc4336'; then
			insmod "$MODULE_DIR/sensor_sc4336_PRJ008.ko" \
				|| { echo 'T33gs: SC4336 load failed; inspect I2C and dmesg' >&2; exit 1; }
		fi
		AUDIO_MODULE_DIR="/lib/modules/$(uname -r)/ingenic"
		if [ -f "$AUDIO_MODULE_DIR/audio.ko" ] && ! lsmod | grep -q '^audio'; then
			# Keep codec GPIO control disabled until package pin 52 is mapped
			# to a Linux GPIO offset; the board signal is active high.
			insmod "$AUDIO_MODULE_DIR/audio.ko" spk_gpio=-1 \
				|| echo 'T33gs: OSS3 microphone driver failed; inspect dmesg' >&2
		fi
		;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop}" >&2
		exit 1
		;;
esac
