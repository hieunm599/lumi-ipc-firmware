# Legacy platform data, not DTB. UART/DDR/MTD remain in the T23 base config.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_V12_JZ=y
CONFIG_I2C0_V12_JZ=y
CONFIG_I2C0_PA12_PA13=y
CONFIG_I2C0_SPEED=100
CONFIG_USB=y
CONFIG_USB_JZ_DWC2=y
CONFIG_USB_DWC2_HOST_ONLY=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_JZMMC_V12=m
CONFIG_JZMMC_V12_MMC0=y
CONFIG_JZMMC_V12_MMC0_PB_4BIT=y
# CONFIG_JZMMC_V12_MMC1 is not set
# CONFIG_JZMMC_V12_MMC1_PB_4BIT is not set
# CONFIG_JZ_MAC is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_MODVERSIONS is not set
# Diagnostic profile: isolate SFC DMA/cache and 50 MHz timing from boot failures.
# CONFIG_SFC_DMA is not set
CONFIG_SFC_SPEED=25
